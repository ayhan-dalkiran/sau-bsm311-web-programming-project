@model GymWebsite.Models.Users.ChangePasswordViewModel
@{
    ViewData["Title"] = "Şifre Değiştir";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow border-0">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-shield-lock-fill me-2"></i>Şifre Değiştir</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="ChangePassword" method="post">

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

                        <div class="mb-3">
                            <label asp-for="OldPassword" class="form-label fw-bold">Mevcut Şifre</label>
                            <input asp-for="OldPassword" class="form-control" placeholder="••••••" />
                            <span asp-validation-for="OldPassword" class="text-danger small"></span>
                        </div>

                        <hr />

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-bold">Yeni Şifre</label>
                            <input asp-for="NewPassword" class="form-control" placeholder="En az 6 karakter" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-bold">Yeni Şifre (Tekrar)</label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger fw-bold">Şifreyi Güncelle</button>
                            <a href="/User/Profile" class="btn btn-light">İptal</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>