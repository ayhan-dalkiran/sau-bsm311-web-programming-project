@using GymWebsite.Models.Users
@model UserIdentityAccount

@{
    ViewData["Title"] = "Profil Bilgilerim";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-person-circle me-2"></i>Kullanıcı Profili</h4>
                </div>
                <div class="card-body p-4">
                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label fw-bold text-muted">Ad Soyad:</label>
                        <div class="col-sm-8">
                            <p class="form-control-plaintext fs-5">@Model.FirstName @Model.LastName</p>
                        </div>
                    </div>
                    <hr class="text-muted opacity-25">

                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label fw-bold text-muted">Kullanıcı Adı / Email:</label>
                        <div class="col-sm-8">
                            <p class="form-control-plaintext">@Model.Email</p>
                        </div>
                    </div>
                    <hr class="text-muted opacity-25">

                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label fw-bold text-muted">Telefon Numarası:</label>
                        <div class="col-sm-8">
                            <p class="form-control-plaintext">@(Model.PhoneNumber ?? "Belirtilmemiş")</p>
                        </div>
                    </div>
                    <hr class="text-muted opacity-25">

                    <div class="row mb-3">
                        <label class="col-sm-4 col-form-label fw-bold text-muted">Kayıt Tarihi:</label>
                        <div class="col-sm-8">
                            <p class="form-control-plaintext">@Model.RegistrationDateTime.ToString("dd MMMM yyyy")</p>
                        </div>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                        <a asp-controller="User" asp-action="Edit" class="btn btn-warning me-md-2 shadow-sm">
                            <i class="bi bi-pencil-square me-1"></i> Bilgileri Güncelle
                        </a>
                        <a asp-controller="User" asp-action="Logout" class="btn btn-outline-danger shadow-sm">
                            <i class="bi bi-box-arrow-right me-1"></i> Çıkış Yap
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>