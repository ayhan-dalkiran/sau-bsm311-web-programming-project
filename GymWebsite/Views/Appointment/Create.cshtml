@{
    ViewData["Title"] = "Randevu Al";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-primary">Yeni Randevu Oluştur</h2>
        <p class="text-muted">Size uygun antrenörü ve saati seçerek hemen yerinizi ayırtın.</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger text-center mb-4 shadow-sm">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-calendar-plus me-2"></i>Randevu Detayları</h5>
                </div>
                <div class="card-body p-4">

                    <form asp-action="Create" method="post" id="bookingForm">

                        <div class="mb-4">
                            <label class="form-label fw-bold">Hizmet Türü</label>
                            <select name="ServiceId" class="form-select form-select-lg" id="serviceSelect" onchange="updateSummary()" required>
                                <option value="" data-price="0" data-duration="0" selected>Seçiniz...</option>
                                @if (ViewBag.ServiceList != null)
                                {
                                    // Veritabanındaki hizmetleri döngüyle yazdırıyoruz
                                    foreach (var service in (List<GymWebsite.Models.Business.GymService>)ViewBag.ServiceList)
                                    {
                                        <option value="@service.Id" data-price="@service.Price" data-duration="@service.DurationInMinutes">
                                            @service.Name
                                        </option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Eğitmen Tercihi</label>
                            <select name="TrainerId" class="form-select" id="trainerSelect" asp-items="ViewBag.Trainers" onchange="updateSummary()" required>
                                <option value="" selected disabled>Eğitmen Seçiniz...</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Tarih</label>
                            <input type="date" class="form-control" id="dateInput" min="@DateTime.Now.ToString("yyyy-MM-dd")" onchange="updateSummary()" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold d-block">Müsait Saatler</label>
                            <div class="btn-group-toggle d-flex flex-wrap gap-2" data-toggle="buttons">
                                <input type="radio" class="btn-check" name="timeSlot" id="t1" value="09:00" onchange="selectTime(this)">
                                <label class="btn btn-outline-primary" for="t1">09:00</label>

                                <input type="radio" class="btn-check" name="timeSlot" id="t2" value="10:00" onchange="selectTime(this)">
                                <label class="btn btn-outline-primary" for="t2">10:00</label>

                                <input type="radio" class="btn-check" name="timeSlot" id="t3" value="11:00" onchange="selectTime(this)">
                                <label class="btn btn-outline-primary" for="t3">11:00</label>

                                <input type="radio" class="btn-check" name="timeSlot" id="t4" value="13:00" onchange="selectTime(this)">
                                <label class="btn btn-outline-primary" for="t4">13:00</label>

                                <input type="radio" class="btn-check" name="timeSlot" id="t5" value="14:00" onchange="selectTime(this)">
                                <label class="btn btn-outline-primary" for="t5">14:00</label>

                                <input type="radio" class="btn-check" name="timeSlot" id="t6" value="15:00" onchange="selectTime(this)">
                                <label class="btn btn-outline-primary" for="t6">15:00</label>

                                <input type="radio" class="btn-check" name="timeSlot" id="t7" value="16:00" onchange="selectTime(this)">
                                <label class="btn btn-outline-primary" for="t7">16:00</label>

                                <input type="radio" class="btn-check" name="timeSlot" id="t8" value="17:00" onchange="selectTime(this)">
                                <label class="btn btn-outline-primary" for="t8">17:00</label>
                            </div>
                        </div>

                        <input type="hidden" name="Date" id="finalDateInput" required />

                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow border-0 bg-light position-sticky" style="top: 2rem;">
                <div class="card-body p-4">
                    <h4 class="card-title fw-bold mb-4">Özet</h4>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Hizmet:</span>
                        <span class="fw-bold" id="summaryService">-</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Eğitmen:</span>
                        <span class="fw-bold" id="summaryTrainer">-</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tarih & Saat:</span>
                        <span class="fw-bold text-end" id="summaryDate">-</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Süre:</span>
                        <span class="fw-bold" id="summaryDuration">0 dk</span>
                    </div>

                    <hr>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="h5 mb-0">Toplam Tutar:</span>
                        <span class="h3 text-primary fw-bold mb-0" id="summaryPrice">0 ₺</span>
                    </div>

                    <button type="button" class="btn btn-success w-100 py-3 fw-bold shadow-sm" onclick="submitBooking()">
                        <i class="bi bi-check-circle-fill me-2"></i> Randevuyu Onayla
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    let selectedTime = "";

    function updateSummary() {
        // HTML Elemanlarını Seç
        const serviceSelect = document.getElementById("serviceSelect");
        const trainerSelect = document.getElementById("trainerSelect");
        const dateInput = document.getElementById("dateInput");

        // --- HİZMET BİLGİLERİ ---
        const selectedOption = serviceSelect.options[serviceSelect.selectedIndex];

        // Data attribute'lardan veriyi çek (Veritabanından gelen veriler)
        const serviceName = selectedOption.text;
        const price = selectedOption.getAttribute("data-price") || 0;
        const duration = selectedOption.getAttribute("data-duration") || 0;

        // --- EĞİTMEN BİLGİSİ ---
        // Seçili index 0 ise (Varsayılan) eğitmen seçilmemiştir
        const trainerName = trainerSelect.value ? trainerSelect.options[trainerSelect.selectedIndex].text : "-";

        // --- TARİH BİLGİSİ ---
        const dateValue = dateInput.value;

        // Özeti Güncelle
        if (serviceSelect.value) {
            document.getElementById("summaryService").innerText = serviceName;
            document.getElementById("summaryPrice").innerText = price + " ₺";
            document.getElementById("summaryDuration").innerText = duration + " dk";
        } else {
            document.getElementById("summaryService").innerText = "-";
            document.getElementById("summaryPrice").innerText = "0 ₺";
            document.getElementById("summaryDuration").innerText = "0 dk";
        }

        document.getElementById("summaryTrainer").innerText = trainerName;

        // Tarih ve Saati Ekranda Göster
        let displayDate = dateValue ? dateValue : "-";
        if (selectedTime) {
            displayDate += " / " + selectedTime;
        }
        document.getElementById("summaryDate").innerText = displayDate;
    }

    // Saat butonuna tıklanınca çalışır
    function selectTime(radioBtn) {
        selectedTime = radioBtn.value;
        updateSummary();
    }

    // "Randevuyu Onayla" butonuna basınca çalışır
    function submitBooking() {
        const dateInput = document.getElementById("dateInput").value;
        const serviceId = document.getElementById("serviceSelect").value;
        const trainerId = document.getElementById("trainerSelect").value;

        // 1. Doğrulama
        if (!serviceId || !trainerId || !dateInput || !selectedTime) {
            alert("Lütfen tüm alanları (Hizmet, Eğitmen, Tarih ve Saat) eksiksiz doldurunuz.");
            return;
        }

        // 2. Tarih ve Saati Birleştir (Örn: "2023-12-25T14:00")
        const finalDateTime = dateInput + "T" + selectedTime;
        document.getElementById("finalDateInput").value = finalDateTime;

        // 3. Formu Gönder
        document.getElementById("bookingForm").submit();
    }
</script>