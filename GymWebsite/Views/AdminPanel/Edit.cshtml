@model GymWebsite.Models.Staff.Trainer

@{
    ViewData["Title"] = "Antrenör Düzenle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark">Antrenör Düzenle</h3>
            <p class="text-muted mb-0">Mevcut eğitmen bilgilerini ve hizmetlerini güncelleyin.</p>
        </div>
        <a href="/AdminPanel/Trainers" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i> Listeye Dön
        </a>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">

                    <form asp-controller="AdminPanel" asp-action="Edit" method="post" enctype="multipart/form-data">

                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-muted small">AD</label>
                                <input asp-for="FirstName" class="form-control form-control-lg" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold text-muted small">SOYAD</label>
                                <input asp-for="LastName" class="form-control form-control-lg" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small">UZMANLIK ALANLARI</label>
                            <div class="alert alert-light border small py-2">
                                <i class="bi bi-info-circle me-1"></i> Şu anki uzmanlıklar seçili gelecektir. (Değiştirmek için CTRL ile seçin)
                            </div>
                            <select name="SelectedSpecialtyIds" class="form-select" multiple size="4">
                                <option value="1">Fitness & Vücut Geliştirme</option>
                                <option value="2">Pilates</option>
                                <option value="3">Yoga</option>
                                <option value="4">Kardiyo / Kondisyon</option>
                                <option value="5">Boks / Kick Boks</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-muted small">HİZMET YETKİLERİ</label>
                            <div class="card p-3 bg-light border-0">
                                <div class="row">
                                    @if (ViewBag.Services != null)
                                    {
                                        var services = ViewBag.Services as List<string>;
                                        if (services != null)
                                        {
                                            foreach (var service in services)
                                            {
                                                <div class="col-md-6">
                                                    <div class="form-check form-switch mb-2">
                                                        <input class="form-check-input" type="checkbox" name="SelectedServices" value="@service" id="edit_srv_@service.GetHashCode()">
                                                        <label class="form-check-label" for="edit_srv_@service.GetHashCode()">
                                                            @service
                                                        </label>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <div class="text-muted small">Hizmet listesi yüklenemedi.</div>
                                    }
                                </div>
                            </div>
                            <div class="form-text text-muted small mt-1">
                                <i class="bi bi-info-circle"></i> İşaretlediğiniz hizmetler antrenörün profilinde aktif edilecektir.
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-muted small">BİYOGRAFİ / HAKKINDA</label>
                            <textarea asp-for="Bio" class="form-control" rows="5"></textarea>
                            <span asp-validation-for="Bio" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 p-3 bg-light rounded border border-dashed d-flex align-items-center">
                            <div class="me-3">
                                <div class="bg-white p-1 rounded shadow-sm border">
                                    <img src="https://ui-avatars.com/api/?name=@(Model.FirstName)+@(Model.LastName)&background=random" class="rounded" width="60" height="60" alt="Mevcut Foto">
                                </div>
                            </div>
                            <div class="flex-grow-1">
                                <label class="form-label fw-bold mb-1">Fotoğrafı Değiştir</label>
                                <input type="file" name="ImageFile" class="form-control form-control-sm" />
                                <div class="form-text text-muted small">Yeni dosya seçerseniz eskisi silinir (JPG/PNG).</div>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a href="/AdminPanel/Trainers" class="btn btn-light border px-4">İptal</a>
                            <button type="submit" class="btn btn-warning fw-bold text-dark px-5">
                                <i class="bi bi-pencil-square me-2"></i> GÜNCELLE
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}