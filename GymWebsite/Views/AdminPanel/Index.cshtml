@model GymWebsite.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Genel Bakış";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row mb-4">
    <div class="col-12">
        <h3 class="fw-bold text-dark">Genel Bakış</h3>
        <p class="text-muted">Spor salonunun anlık durum raporu.</p>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 border-start border-4 border-primary">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase text-muted small fw-bold mb-1">Toplam Üye</div>
                        <div class="h3 mb-0 fw-bold text-dark">@Model.TotalMembers</div>
                    </div>
                    <div class="fs-1 text-primary opacity-25"><i class="bi bi-people-fill"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 border-start border-4 border-success">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase text-muted small fw-bold mb-1">Antrenörler</div>
                        <div class="h3 mb-0 fw-bold text-dark">@Model.TotalTrainers</div>
                    </div>
                    <div class="fs-1 text-success opacity-25"><i class="bi bi-person-badge-fill"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100 border-start border-4 border-warning">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase text-muted small fw-bold mb-1">Bugünkü Randevu</div>
                        <div class="h3 mb-0 fw-bold text-dark">@Model.TodayAppointmentsCount</div>
                    </div>
                    <div class="fs-1 text-warning opacity-25"><i class="bi bi-calendar-check-fill"></i></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-5 text-center text-muted">
                <i class="bi bi-grid-1x2-fill fs-1 mb-3 d-block text-secondary"></i>
                <h5>Yönetim Paneline Hoş Geldiniz</h5>
                <p>Sol taraftaki menüyü kullanarak Salon bilgilerini güncelleyebilir, Antrenör ekleyebilir, Kullanıcıları ve Randevuları yönetebilirsiniz.</p>
            </div>
        </div>
    </div>
</div>