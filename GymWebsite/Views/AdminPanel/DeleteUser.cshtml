@model GymWebsite.Models.Users.UserIdentityAccount

@{
    ViewData["Title"] = "Üyeyi Sil";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container d-flex flex-column align-items-center justify-content-center py-5">
    <div class="card border-0 shadow-lg text-center" style="max-width: 500px;">
        <div class="card-header bg-danger text-white py-3">
            <h5 class="mb-0 fw-bold">Silme İşlemi</h5>
        </div>
        <div class="card-body p-5">
            <div class="mb-4 text-danger">
                <i class="bi bi-person-x-fill fs-1"></i>
            </div>
            <h4 class="fw-bold">@Model.FirstName @Model.LastName</h4>
            <p class="text-muted">Bu üyeyi ve tüm randevu geçmişini silmek istediğinize emin misiniz?</p>

            <form asp-action="DeleteUser" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger btn-lg w-100 mb-2">EVET, SİL</button>
                <a asp-action="Users" href="/AdminPanel/Users" class="btn btn-light w-100">Vazgeç</a>
            </form>
        </div>
    </div>
</div>