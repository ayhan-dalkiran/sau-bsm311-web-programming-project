@model GymWebsite.Models.Business.Gym

@{
    ViewData["Title"] = "Salon ve Hizmet Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark">Salon Tanımlamaları</h3>
            <p class="text-muted mb-0">Salon bilgilerini ve sunulan hizmetlerin ücret/süre detaylarını yönetin.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm">
            <i class="bi bi-trash3-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-lg-5 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-building me-2"></i> Salon Bilgileri</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="EditGym" asp-route-id="@Model.Id" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-bold text-muted small"></label>
                            <input asp-for="Name" class="form-control form-control-lg" placeholder="Örn: Power Gym Center" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Address" class="form-label fw-bold text-muted small"></label>
                            <textarea asp-for="Address" class="form-control" rows="3" placeholder="Açık adres bilgisi..."></textarea>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="PhoneNumber" class="form-label fw-bold text-muted small"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                                    <input asp-for="PhoneNumber" class="form-control" placeholder="0212 555 55 55" />
                                </div>
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="Email" class="form-label fw-bold text-muted small"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" class="form-control" placeholder="info@powergym.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <h6 class="fw-bold text-dark mb-3"><i class="bi bi-clock me-2"></i>Çalışma Saatleri</h6>
                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="WeekdayHours" class="form-label fw-bold text-muted small"></label>
                                <input asp-for="WeekdayHours" class="form-control" placeholder="09:00 - 22:00" />
                                <span asp-validation-for="WeekdayHours" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label asp-for="WeekendHours" class="form-label fw-bold text-muted small"></label>
                                <input asp-for="WeekendHours" class="form-control" placeholder="10:00 - 20:00" />
                                <span asp-validation-for="WeekendHours" class="text-danger small"></span>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 fw-bold py-2">
                            <i class="bi bi-save me-2"></i> DEĞİŞİKLİKLERİ KAYDET
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-7 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-success"><i class="bi bi-tags-fill me-2"></i> Hizmetler & Ücretler</h5>
                    <a href="/AdminPanel/AddGymService" class="btn btn-sm btn-outline-success fw-bold">
                        <i class="bi bi-plus-lg me-1"></i> Yeni Hizmet Ekle
                    </a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">Hizmet Adı</th>
                                    <th>Ücret</th>
                                    <th>Süre</th>
                                    <th class="text-end pe-4">İşlem</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Services != null && Model.Services.Any())
                                {
                                    @foreach (var service in Model.Services)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <div class="fw-bold text-dark">@service.Name</div>
                                                <div class="small text-muted text-truncate" style="max-width: 250px;">@service.Description</div>
                                            </td>
                                            <td><span class="badge bg-success bg-opacity-10 text-success border border-success px-2">@service.Price.ToString("C2")</span></td>
                                            <td>
                                                @if (service.DurationInMinutes > 0)
                                                {
                                                    <span><i class="bi bi-clock me-1"></i>@service.DurationInMinutes dk</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">-</span>
                                                }
                                            </td>
                                            <td class="text-end pe-4">
                                                <a href="/AdminPanel/EditGymService/@service.Id" class="btn btn-sm btn-warning text-dark border me-1" title="Düzenle">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>

                                                <a href="/AdminPanel/DeleteGymService/@service.Id" class="btn btn-sm btn-light text-danger border" onclick="return confirm('Silmek istediğinize emin misiniz?')">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="4" class="text-center py-4 text-muted">Kayıtlı hizmet bulunamadı.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>