@model GymWebsite.Models.Business.GymService

@{
    ViewData["Title"] = "Hizmeti Düzenle";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="card shadow mb-4" style="max-width: 600px; margin: 0 auto;">
        <div class="card-header py-3 bg-warning">
            <h6 class="m-0 font-weight-bold text-dark"><i class="bi bi-pencil-square me-2"></i>Hizmeti Düzenle</h6>
        </div>
        <div class="card-body">
            <form asp-action="EditGymService" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-bold">Hizmet Adı</label>
                    <input asp-for="Name" class="form-control" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold">Açıklama</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Price" class="form-label fw-bold">Ücret (₺)</label>
                        <input asp-for="Price" type="number" step="0.01" class="form-control" required />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="DurationInMinutes" class="form-label fw-bold">Süre (Dakika)</label>
                        <input asp-for="DurationInMinutes" type="number" class="form-control" required />
                        <span asp-validation-for="DurationInMinutes" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a href="/AdminPanel/Gym" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-2"></i>İptal
                    </a>
                    <button type="submit" class="btn btn-warning fw-bold px-4">
                        <i class="bi bi-save me-2"></i>Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>