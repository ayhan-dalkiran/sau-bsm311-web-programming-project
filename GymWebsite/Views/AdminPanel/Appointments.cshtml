@using GymWebsite.Models
@model IEnumerable<Appointment>

@{
    ViewData["Title"] = "Randevu Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">Randevular</h3>
            <p class="text-muted mb-0">Üyelerin aldığı ders randevularını buradan yönetin.</p>
        </div>

        <div class="d-flex gap-2">
            <span class="badge bg-white text-secondary border p-2">Toplam: @(Model?.Count() ?? 0)</span>
            <span class="badge bg-success bg-opacity-10 text-success border border-success p-2">Onaylı: @(Model?.Count(x => x.Status == AppointmentStatus.Confirmed) ?? 0)</span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-circle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Tarih / Saat</th>
                            <th>Üye Bilgisi</th>
                            <th>Antrenör</th>
                            <th>Ücret / Süre</th>
                            <th>Durum</th>
                            <th class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex flex-column">
                                            <span class="fw-bold text-dark">@item.Date.ToString("dd.MM.yyyy")</span>
                                            <span class="small text-muted"><i class="bi bi-clock me-1"></i>@item.Date.ToString("HH:mm")</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-2 fw-bold" style="width: 35px; height: 35px;">
                                                @(item.GymMember?.FirstName?.Substring(0, 1) ?? "U")
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark">
                                                    @(item.GymMember != null ? item.GymMember.FirstName + " " + item.GymMember.LastName : "Misafir")
                                                </div>
                                                <div class="small text-muted">@(item.GymMember?.Email ?? "-")</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-person-badge me-1"></i>
                                            @(item.Trainer != null ? item.Trainer.FirstName + " " + item.Trainer.LastName : "Belirtilmemiş")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="small fw-bold">@item.Price.ToString("C2")</div>
                                        <div class="small text-muted"><i class="bi bi-hourglass-split"></i> @item.DurationInMinutes dk</div>
                                    </td>
                                    <td>
                                        @if (item.Status == AppointmentStatus.Confirmed)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Onaylandı</span>
                                        }
                                        else if (item.Status == AppointmentStatus.Pending)
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3">Bekliyor</span>
                                        }
                                        else if (item.Status == AppointmentStatus.Cancelled)
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3">İptal</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3">Tamamlandı</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group">
                                            <a href="/AdminPanel/ApproveAppointment/@item.Id" class="btn btn-sm btn-outline-success" title="Onayla">
                                                <i class="bi bi-check-lg"></i>
                                            </a>

                                            <a href="/AdminPanel/CancelAppointment/@item.Id" class="btn btn-sm btn-outline-warning ms-1" title="İptal Et">
                                                <i class="bi bi-x-lg"></i>
                                            </a>

                                            <a href="/AdminPanel/DeleteAppointment/@item.Id" class="btn btn-sm btn-outline-danger ms-1" title="Kalıcı Sil">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" class="text-center py-5 text-muted">Randevu bulunamadı.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>