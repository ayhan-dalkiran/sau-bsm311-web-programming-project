@{
    ViewData["Title"] = "Antrenör Yönetimi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Antrenörler</h3>
        <p class="text-muted mb-0">Spor salonundaki eğitmenleri yönet.</p>
    </div>
    <a href="/AdminPanel/Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-2"></i> Yeni Antrenör Ekle
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Antrenör Adı</th>
                        <th>Uzmanlık</th>
                        <th>Çalışma Saatleri</th>
                        <th>Durum</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center">
                                <img src="https://ui-avatars.com/api/?name=Ali+Veli&background=0D6EFD&color=fff" class="rounded-circle me-3" width="40" height="40">
                                <div>
                                    <div class="fw-bold text-dark">Ali Veli</div>
                                    <div class="small text-muted">ali@powergym.com</div>
                                </div>
                            </div>
                        </td>
                        <td><span class="badge bg-info bg-opacity-10 text-info">Fitness</span></td>
                        <td>09:00 - 18:00</td>
                        <td><span class="badge bg-success">Aktif</span></td>
                        <td class="text-end pe-4">
                            <a href="/AdminPanel/Edit/1" class="btn btn-sm btn-outline-warning me-1" title="Düzenle">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <a href="/AdminPanel/Delete/1" class="btn btn-sm btn-outline-danger" title="Sil">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>

                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center">
                                <img src="https://ui-avatars.com/api/?name=Ayse+Yilmaz&background=dc3545&color=fff" class="rounded-circle me-3" width="40" height="40">
                                <div>
                                    <div class="fw-bold text-dark">Ayşe Yılmaz</div>
                                    <div class="small text-muted">ayse@powergym.com</div>
                                </div>
                            </div>
                        </td>
                        <td><span class="badge bg-warning bg-opacity-10 text-warning">Pilates</span></td>
                        <td>10:00 - 16:00</td>
                        <td><span class="badge bg-success">Aktif</span></td>
                        <td class="text-end pe-4">
                            <a href="/AdminPanel/Edit/2" class="btn btn-sm btn-outline-warning me-1" title="Düzenle">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <a href="/AdminPanel/Delete/2" class="btn btn-sm btn-outline-danger" title="Sil">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>

                </tbody>
            </table>
        </div>
    </div>
</div>