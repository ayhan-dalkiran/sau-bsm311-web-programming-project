@{
    ViewData["Title"] = "AI Fitness Asistanı";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary">
            <i class="bi bi-robot"></i> AI Fitness Asistanı
        </h1>
        <p class="lead text-muted">Vücut ölçülerini gir, yapay zeka sana özel programı hazırlasın.</p>
    </div>

    <div class="row">
        <div class="col-lg-5 mb-4">
            <div class="card shadow-lg border-0 h-100">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0"><i class="bi bi-sliders"></i> Fiziksel Bilgilerin</h5>
                </div>
                <div class="card-body p-4">
                    <form id="aiForm">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Cinsiyet</label>
                            <select class="form-select">
                                <option>Erkek</option>
                                <option>Kadın</option>
                            </select>
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col">
                                <label class="form-label fw-bold">Yaş</label>
                                <input type="number" class="form-control" placeholder="25">
                            </div>
                            <div class="col">
                                <label class="form-label fw-bold">Boy (cm)</label>
                                <input type="number" class="form-control" placeholder="180">
                            </div>
                            <div class="col">
                                <label class="form-label fw-bold">Kilo (kg)</label>
                                <input type="number" class="form-control" placeholder="80">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Hedefin Nedir?</label>
                            <select class="form-select" id="goalSelect">
                                <option value="lose">Kilo Vermek / Yağ Yakmak</option>
                                <option value="muscle">Kas Kütlesi Kazanmak</option>
                                <option value="fit">Formda Kalmak (Fit)</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Vücut Fotoğrafı (Opsiyonel)</label>
                            <input type="file" class="form-control" accept="image/*">
                            <small class="text-muted">Daha doğru analiz için boydan bir fotoğraf yükleyin.</small>
                        </div>

                        <div class="d-grid">
                            <button type="button" onclick="simulateAI()" class="btn btn-primary btn-lg fw-bold">
                                <i class="bi bi-stars"></i> Programımı Oluştur
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div id="startScreen" class="text-center d-flex flex-column justify-content-center align-items-center h-100 p-5 bg-light rounded-3 border border-dashed">
                <i class="bi bi-cpu fs-1 text-muted mb-3"></i>
                <h4 class="text-muted">Veri Bekleniyor...</h4>
                <p class="text-muted">Analiz sonuçlarınız burada görüntülenecektir.</p>
            </div>

            <div id="loadingScreen" class="text-center d-none h-100 py-5">
                <div class="spinner-border text-primary" style="width: 4rem; height: 4rem;" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <h4 class="mt-4 animate-pulse">Yapay Zeka Verilerini Analiz Ediyor...</h4>
                <p class="text-muted">Metabolizma hızı hesaplanıyor, egzersizler taranıyor.</p>
            </div>

            <div id="resultScreen" class="card shadow-lg border-0 border-top border-5 border-success d-none">
                <div class="card-body p-4">
                    <h3 class="card-title text-success mb-4">
                        <i class="bi bi-check-circle-fill"></i> Analiz Tamamlandı!
                    </h3>

                    <div class="alert alert-light border">
                        <strong>AI Özeti:</strong> Vücut kitle indeksiniz (BMI) ve hedeflerinize göre, sizin için
                        <span class="badge bg-warning text-dark">Orta Seviye</span> bir hipertrofi (kas büyümesi) programı hazırladım.
                    </div>

                    <ul class="nav nav-tabs mb-3" id="aiTabs" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#diet" type="button">Beslenme Planı</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#workout" type="button">Antrenman Programı</button>
                        </li>
                    </ul>

                    <div class="tab-content">
                        <div class="tab-pane fade show active" id="diet">
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>🍳 <strong>Kahvaltı:</strong> 3 Yumurta, Yulaf, Muz</span>
                                    <span class="badge bg-info rounded-pill">450 kcal</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>🍗 <strong>Öğle:</strong> Izgara Tavuk, Pirinç, Salata</span>
                                    <span class="badge bg-info rounded-pill">600 kcal</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>🐟 <strong>Akşam:</strong> Somon/Ton Balığı, Sebze</span>
                                    <span class="badge bg-info rounded-pill">500 kcal</span>
                                </li>
                            </ul>
                        </div>

                        <div class="tab-pane fade" id="workout">
                            <div class="table-responsive">
                                <table class="table table-sm table-hover">
                                    <thead>
                                        <tr>
                                            <th>Egzersiz</th>
                                            <th>Set</th>
                                            <th>Tekrar</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr><td>Bench Press</td><td>4</td><td>8-10</td></tr>
                                        <tr><td>Squat</td><td>4</td><td>8-10</td></tr>
                                        <tr><td>Lat Pulldown</td><td>3</td><td>12</td></tr>
                                        <tr><td>Shoulder Press</td><td>3</td><td>10</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 text-center">
                        <button class="btn btn-outline-success btn-sm">Programı PDF Olarak İndir</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function simulateAI() {
        
        var startScreen = document.getElementById("startScreen");
        var loadingScreen = document.getElementById("loadingScreen");
        var resultScreen = document.getElementById("resultScreen");

        
        startScreen.classList.add("d-none");
        startScreen.classList.remove("d-flex");

        loadingScreen.classList.remove("d-none");
        resultScreen.classList.add("d-none");

        // 2.5 saniye bekle -
        setTimeout(function() {
            
            loadingScreen.classList.add("d-none");
            resultScreen.classList.remove("d-none");
        }, 2500);
    }
</script>

<style>
    @@keyframes pulse {
        0%

    {
        opacity: 0.5;
    }

    50% {
        opacity: 1;
    }

    100% {
        opacity: 0.5;
    }

    }

    .animate-pulse {
        animation: pulse 1.5s infinite;
    }
</style>