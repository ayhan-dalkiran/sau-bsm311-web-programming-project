@{
    ViewData["Title"] = "Eğitmen Kadromuz";
}

<div class="bg-light py-5 mb-5 text-center">
    <div class="container">
        <h1 class="display-4 fw-bold text-dark">Uzman Kadromuz</h1>
        <p class="lead text-muted">Hedeflerinize ulaşmanız için size özel programlar hazırlayan profesyonel ekibimizle tanışın.</p>
    </div>
</div>

<div class="container mb-5">
    <div class="row row-cols-1 row-cols-md-3 g-4">

        <div class="col">
            <div class="card h-100 shadow border-0 text-center hover-effect">
                <div class="position-relative">
                    <img src="https://images.unsplash.com/photo-1594381898411-846e7d193883?q=80&w=1887&auto=format&fit=crop"
                         class="card-img-top" alt="Antrenör Foto" style="height: 350px; object-fit: cover;">
                    <div class="position-absolute bottom-0 start-0 w-100 bg-dark bg-opacity-75 text-white py-2">
                        <span class="fw-bold">Vücut Geliştirme</span>
                    </div>
                </div>

                <div class="card-body">
                    <h4 class="card-title fw-bold">Mehmet Demir</h4>
                    <p class="card-text text-muted">5 yıllık tecrübesiyle hipertrofi ve güç antrenmanları konusunda uzmandır.</p>

                    <div class="mb-3">
                        <span class="badge bg-primary rounded-pill">Fitness</span>
                        <span class="badge bg-secondary rounded-pill">CrossFit</span>
                    </div>

                    <a href="#" class="btn btn-outline-dark w-100 fw-bold">Profili İncele & Randevu Al</a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow border-0 text-center hover-effect">
                <div class="position-relative">
                    <img src="https://images.unsplash.com/photo-1518611012118-696072aa579a?q=80&w=1470&auto=format&fit=crop"
                         class="card-img-top" alt="Antrenör Foto" style="height: 350px; object-fit: cover;">
                    <div class="position-absolute bottom-0 start-0 w-100 bg-dark bg-opacity-75 text-white py-2">
                        <span class="fw-bold">Yoga & Pilates</span>
                    </div>
                </div>

                <div class="card-body">
                    <h4 class="card-title fw-bold">Ayşe Yılmaz</h4>
                    <p class="card-text text-muted">Esneklik, denge ve zihinsel odaklanma konularında sertifikalı eğitmendir.</p>

                    <div class="mb-3">
                        <span class="badge bg-success rounded-pill">Yoga</span>
                        <span class="badge bg-info rounded-pill text-dark">Pilates</span>
                    </div>

                    <a href="#" class="btn btn-outline-dark w-100 fw-bold">Profili İncele & Randevu Al</a>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow border-0 text-center hover-effect">
                <div class="position-relative">
                    <img src="https://images.unsplash.com/photo-1571019614242-c5c5dee9f50b?q=80&w=1470&auto=format&fit=crop"
                         class="card-img-top" alt="Antrenör Foto" style="height: 350px; object-fit: cover;">
                    <div class="position-absolute bottom-0 start-0 w-100 bg-dark bg-opacity-75 text-white py-2">
                        <span class="fw-bold">Kilo Verme & Kardiyo</span>
                    </div>
                </div>

                <div class="card-body">
                    <h4 class="card-title fw-bold">Caner Kaya</h4>
                    <p class="card-text text-muted">Yüksek yoğunluklu interval antrenmanlar (HIIT) ile hızlı yağ yakımı uzmanı.</p>

                    <div class="mb-3">
                        <span class="badge bg-danger rounded-pill">HIIT</span>
                        <span class="badge bg-warning rounded-pill text-dark">Kardiyo</span>
                    </div>

                    <a href="#" class="btn btn-outline-dark w-100 fw-bold">Profili İncele & Randevu Al</a>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .hover-effect {
        transition: transform 0.3s;
    }

    .hover-effect:hover {
       transform: translateY(-10px);
     }
</style>