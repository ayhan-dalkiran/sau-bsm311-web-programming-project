@model GymWebsite.Models.Business.Gym

@{
    ViewData["Title"] = Model.Name;
    var services = Model.Services.ToList();
}

<div class="p-5 mb-4 bg-dark rounded-3 text-white"
     style="background-image: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('https://images.unsplash.com/photo-1571902943202-507ec2618e8f?q=80&w=1975&auto=format&fit=crop'); background-size: cover; background-position: center;">
    <div class="container-fluid py-5 text-center">
        <h1 class="display-3 fw-bold">@Model.Name</h1>
        <p class="fs-4">Modern ekipmanlar ve uzman kadro ile değişime başla.</p>

        <a asp-controller="Appointment" asp-action="Create" class="btn btn-warning btn-lg mt-3 fw-bold px-5">
            Hemen Randevu Al
        </a>
    </div>
</div>

<div class="container">
    <div class="row mb-5">
        <div class="col-md-8">
            <h2 class="border-bottom pb-2 mb-3 text-primary">Hakkımızda & İletişim</h2>
            <p class="lead">Şehrin en kapsamlı spor kompleksi. Geniş antrenman alanları, profesyonel eğitmen kadrosu ve en yeni teknoloji fitness ekipmanları ile hizmetinizdeyiz.</p>

            <div class="row mt-4">
                <div class="col-md-6">
                    <h5><i class="bi bi-geo-alt-fill text-danger"></i> Adres</h5>
                    <p>@Model.Address</p>
                </div>
                <div class="col-md-6">
                    <h5><i class="bi bi-telephone-fill text-success"></i> İletişim</h5>
                    <p>
                        @Model.PhoneNumber<br>
                        <a href="mailto:@Model.Email" class="text-decoration-none text-dark">@Model.Email</a>
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-light border-0 shadow-sm">
                <div class="card-body">
                    <h4 class="card-title text-center mb-4"><i class="bi bi-clock"></i> Çalışma Saatleri</h4>
                    <ul class="list-group list-group-flush bg-transparent">
                        <li class="list-group-item bg-transparent d-flex justify-content-between">
                            <span>Hafta İçi</span>
                            <strong>@Model.WeekdayHours</strong>
                        </li>
                        <li class="list-group-item bg-transparent d-flex justify-content-between">
                            <span>Hafta Sonu</span>
                            <strong>@Model.WeekendHours</strong>
                        </li>
                        <li class="list-group-item bg-transparent d-flex justify-content-between text-muted small text-center mt-2">
                            <span>*Resmi tatillerde değişiklik gösterebilir.</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <h2 class="text-center mb-4 text-primary">Sunduğumuz Hizmetler</h2>

    @if (services.Any())
    {
        <div class="row row-cols-1 row-cols-md-3 g-4 mb-5">
            @foreach (var service in services)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 hover-effect">
                        <div class="card-header bg-dark text-white text-center fw-bold">@service.Name</div>
                        <div class="card-body text-center d-flex flex-column">
                            <h1 class="card-title pricing-card-title text-primary">
                                ₺@service.Price.ToString("0.##")<small class="text-muted fw-light fs-6"> / seans</small>
                            </h1>

                            <ul class="list-unstyled mt-3 mb-4 flex-grow-1">
                                <li>@service.Description</li>
                                <li class="text-muted mt-2"><i class="bi bi-clock me-1"></i> @service.DurationInMinutes dk</li>
                            </ul>

                            <a asp-controller="Appointment" asp-action="Create" class="btn btn-outline-primary w-100 mt-auto fw-bold">
                                Randevu Al
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center py-5">
            <i class="bi bi-exclamation-circle fs-1 d-block mb-3"></i>
            <h4>Henüz eklenmiş bir hizmet bulunmamaktadır.</h4>
            <p>Admin panelinden yeni hizmetler ekleyebilirsiniz.</p>
        </div>
    }
</div>

<style>
    .hover-effect {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .hover-effect:hover {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }
</style>