@{
    ViewData["Title"] = "Salon Bilgileri";
}

<div class="p-5 mb-4 bg-dark rounded-3 text-white"
     style="background-image: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('https://images.unsplash.com/photo-1571902943202-507ec2618e8f?q=80&w=1975&auto=format&fit=crop'); background-size: cover; background-position: center;">
    <div class="container-fluid py-5 text-center">
        <h1 class="display-3 fw-bold">Power Gym Center</h1>
        <p class="fs-4">Modern ekipmanlar ve uzman kadro ile değişime başla.</p>
        <button class="btn btn-warning btn-lg mt-3 fw-bold px-5" type="button">Hemen Randevu Al</button>
    </div>
</div>

<div class="container">
    <div class="row mb-5">
        <div class="col-md-8">
            <h2 class="border-bottom pb-2 mb-3 text-primary">Hakkımızda & İletişim</h2>
            <p class="lead">Şehrin en kapsamlı spor kompleksi. 2000 m² alan, havuz, sauna ve en yeni teknoloji fitness ekipmanları ile hizmetinizdeyiz.</p>

            <div class="row mt-4">
                <div class="col-md-6">
                    <h5><i class="bi bi-geo-alt-fill text-danger"></i> Adres</h5>
                    <p>Atatürk Caddesi, No: 123<br>Merkez / İstanbul</p>
                </div>
                <div class="col-md-6">
                    <h5><i class="bi bi-telephone-fill text-success"></i> İletişim</h5>
                    <p>0 (212) 555 55 55<br>info@powergym.com</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card bg-light border-0 shadow-sm">
                <div class="card-body">
                    <h4 class="card-title text-center mb-4"><i class="bi bi-clock"></i> Çalışma Saatleri</h4>
                    <ul class="list-group list-group-flush bg-transparent">
                        <li class="list-group-item bg-transparent d-flex justify-content-between">
                            <span>Hafta İçi</span>
                            <strong>09:00 - 22:00</strong>
                        </li>
                        <li class="list-group-item bg-transparent d-flex justify-content-between">
                            <span>Cumartesi</span>
                            <strong>10:00 - 20:00</strong>
                        </li>
                        <li class="list-group-item bg-transparent d-flex justify-content-between text-danger">
                            <span>Pazar</span>
                            <strong>Kapalı</strong>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <h2 class="text-center mb-4 text-primary">Sunduğumuz Hizmetler</h2>
    <div class="row row-cols-1 row-cols-md-3 g-4 mb-5">

        <div class="col">
            <div class="card h-100 shadow-sm border-0 hover-effect">
                <div class="card-header bg-dark text-white text-center">Fitness</div>
                <div class="card-body text-center">
                    <h1 class="card-title pricing-card-title">₺750<small class="text-muted fw-light">/ay</small></h1>
                    <ul class="list-unstyled mt-3 mb-4">
                        <li>Sınırsız Salon Kullanımı</li>
                        <li>Ücretsiz Program Yazımı</li>
                        <li>Duş ve Dolap</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow border-primary">
                <div class="card-header bg-primary text-white text-center">Yoga & Pilates</div>
                <div class="card-body text-center">
                    <h1 class="card-title pricing-card-title">₺400<small class="text-muted fw-light">/seans</small></h1>
                    <ul class="list-unstyled mt-3 mb-4">
                        <li>Birebir (PT) İlgi</li>
                        <li>50 Dakika Seans</li>
                        <li>Esneklik ve Denge</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-header bg-dark text-white text-center">Havuz Üyeliği</div>
                <div class="card-body text-center">
                    <h1 class="card-title pricing-card-title">₺1000<small class="text-muted fw-light">/ay</small></h1>
                    <ul class="list-unstyled mt-3 mb-4">
                        <li>Yarı Olimpik Havuz</li>
                        <li>Sauna Erişimi</li>
                        <li>Hijyenik Ortam</li>
                    </ul>
                </div>
            </div>
        </div>

    </div>
</div>