@model GymWebsite.Models.Business.Gym
@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="position-relative text-center text-white mb-5">
    <div style="background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('https://images.unsplash.com/photo-1534438327276-14e5300c3a48?auto=format&fit=crop&w=1950&q=80');
                background-size: cover; background-position: center; padding: 100px 0;">
        <div class="container">
            <h1 class="display-3 fw-bold mb-3">@Model.Name'e Hoş Geldiniz</h1>
            <p class="lead mb-4 fs-4">Hayalindeki vücuda kavuşmak için en doğru yerdesin. Profesyonel eğitmenler ve modern ekipmanlar seni bekliyor.</p>

            <a asp-controller="Appointment" asp-action="Create" class="btn btn-primary btn-lg fw-bold px-5 py-3 rounded-pill shadow-lg hover-scale">
                <i class="bi bi-calendar-check-fill me-2"></i> HEMEN RANDEVU AL
            </a>
        </div>
    </div>
</div>

<div class="container my-5">
    <div class="row g-4 justify-content-center">
        <div class="col-md-5">
            <div class="card h-100 border-0 shadow-sm text-center p-4 hover-card">
                <div class="text-primary mb-3"><i class="bi bi-clock-history fs-1"></i></div>
                <h4 class="fw-bold mb-3">Çalışma Saatleri</h4>
                <ul class="list-unstyled">
                    <li class="mb-2 fs-5">Hafta İçi: <span class="fw-bold text-dark">@Model.WeekdayHours</span></li>
                    <li class="fs-5">Hafta Sonu: <span class="fw-bold text-dark">@Model.WeekendHours</span></li>
                </ul>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card h-100 border-0 shadow-sm text-center p-4 hover-card">
                <div class="text-primary mb-3"><i class="bi bi-geo-alt-fill fs-1"></i></div>
                <h4 class="fw-bold mb-3">Bize Ulaşın</h4>
                <p class="text-muted mb-1 fs-5">@Model.Address</p>
                <p class="text-dark fw-bold fs-4 mt-2">@Model.PhoneNumber</p>
            </div>
        </div>
    </div>
</div>

<div class="bg-light py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold display-5">Sunduğumuz Hizmetler</h2>
            <p class="text-muted fs-5">Hedeflerinize ulaşmanız için geniş hizmet yelpazesi</p>
        </div>

        <div class="row g-4">
            @if (Model.Services != null && Model.Services.Any())
            {
                foreach (var service in Model.Services)
                {
                    <div class="col-md-4">
                        <div class="card h-100 border-0 shadow-sm hover-effect transition-card">
                            <div class="card-body text-center p-4 d-flex flex-column">
                                <div class="mb-3 text-primary">
                                    <i class="bi bi-activity fs-1"></i>
                                </div>
                                <h4 class="card-title fw-bold">@service.Name</h4>
                                <p class="card-text text-muted flex-grow-1">@service.Description</p>

                                <hr class="my-3">

                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="badge bg-light text-dark border p-2"><i class="bi bi-clock me-1"></i> @service.DurationInMinutes dk</span>
                                    <span class="h4 text-success fw-bold mb-0">@service.Price.ToString("C0") ₺</span>
                                </div>

                                <a asp-controller="Appointment" asp-action="Create" class="btn btn-outline-primary w-100 fw-bold rounded-pill">
                                    Randevu Al
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center text-muted py-5">
                    <div class="bg-white p-5 rounded shadow-sm d-inline-block">
                        <i class="bi bi-exclamation-circle fs-1 d-block mb-3 text-warning"></i>
                        <h4 class="fw-normal">Henüz eklenmiş bir hizmet bulunmamaktadır.</h4>
                        <p>Admin panelinden hizmet ekleyerek burayı doldurabilirsiniz.</p>
                        <a href="/AdminPanel/Gym" class="btn btn-sm btn-primary mt-2">Hizmet Ekle (Admin)</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* Ufak Hover Efektleri */
    .hover-card:hover {
        transform: translateY(-5px);
        transition: 0.3s;
    }

    .transition-card {
        transition: all 0.3s ease-in-out;
    }

        .transition-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 1rem 3rem rgba(0,0,0,.175) !important;
        }

    .hover-scale:hover {
        transform: scale(1.05);
    }
</style>