<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PowerGym Admin</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        body {
            overflow-x: hidden;
            background-color: #f8f9fc; /* Hafif gri arka plan (Admin standartı) */
        }

        /* SIDEBAR (SOL MENÜ) TASARIMI */
        #sidebar-wrapper {
            min-height: 100vh;
            width: 250px;
            margin-left: 0;
            background: linear-gradient(180deg, #4e73df 10%, #224abe 100%); /* Admin mavisi */
            color: white;
            transition: margin .25s ease-out;
            position: fixed; /* Sabit kalması için */
            z-index: 1000;
        }

            #sidebar-wrapper .sidebar-heading {
                padding: 1.5rem 1.25rem;
                font-size: 1.2rem;
                font-weight: bold;
                text-align: center;
                border-bottom: 1px solid rgba(255,255,255,0.1);
            }

            #sidebar-wrapper .list-group {
                width: 250px;
            }

            #sidebar-wrapper .list-group-item {
                background-color: transparent;
                color: rgba(255,255,255,0.8);
                border: none;
                padding: 1rem 1.5rem;
                font-weight: 500;
            }

                #sidebar-wrapper .list-group-item:hover {
                    background-color: rgba(255,255,255,0.1);
                    color: #fff;
                }

                #sidebar-wrapper .list-group-item.active {
                    background-color: white;
                    color: #4e73df;
                    font-weight: bold;
                    border-radius: 0.5rem;
                    margin: 0 10px;
                }

        /* İÇERİK ALANI */
        #page-content-wrapper {
            margin-left: 250px; /* Sidebar kadar boşluk bırak */
            width: 100%;
        }

        /* MOBİL UYUMLULUK */
        @@media (max-width: 768px) {
            #sidebar-wrapper

        {
            margin-left: -250px;
        }

        #page-content-wrapper {
            margin-left: 0;
        }

        #sidebar-wrapper.toggled {
            margin-left: 0;
        }

        }
    </style>
</head>
<body>

    <div class="d-flex" id="wrapper">

        <div id="sidebar-wrapper">
            <div class="sidebar-heading">
                <i class="bi bi-shield-lock-fill me-2"></i> Yönetim Paneli
            </div>
            <div class="list-group list-group-flush mt-3">

                <a href="/AdminPanel/Index" class="list-group-item list-group-item-action @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminPanel" ? "active" : "")">
                    <i class="bi bi-speedometer2 me-2"></i> Dashboard
                </a>

                <a href="/AdminPanel/Gyms" class="list-group-item list-group-item-action">
                    <i class="bi bi-building me-2"></i> Salon Bilgileri
                </a>

                <a href="/AdminPanel/Trainers" class="list-group-item list-group-item-action">
                    <i class="bi bi-person-badge-fill me-2"></i> Antrenörler
                </a>

                <a href="/AdminPanel/Users" class="list-group-item list-group-item-action">
                    <i class="bi bi-people-fill me-2"></i> Üyeler
                </a>

                <a href="/AdminPanel/Appointments" class="list-group-item list-group-item-action">
                    <i class="bi bi-calendar-check me-2"></i> Randevular
                </a>

                <hr class="border-light my-2 mx-3 opacity-25">

                <a href="/Home/Index" class="list-group-item list-group-item-action text-warning">
                    <i class="bi bi-box-arrow-left me-2"></i> Siteye Dön
                </a>
            </div>
        </div>
        <div id="page-content-wrapper">

            <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm px-4 py-3">
                <button class="btn btn-outline-primary btn-sm d-md-none" id="menu-toggle">Menü</button>

                <h5 class="ms-3 mb-0 text-muted d-none d-md-block">Hoş Geldin, Admin</h5>

                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav ms-auto mt-2 mt-lg-0 align-items-center">
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="bi bi-bell-fill text-secondary position-relative">
                                    <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle"></span>
                                </i>
                            </a>
                        </li>
                        <li class="nav-item dropdown ms-3">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown">
                                <img src="https://ui-avatars.com/api/?name=Admin&background=0D8ABC&color=fff" class="rounded-circle me-2" width="32" height="32">
                                <span class="fw-bold small text-dark">Yönetici</span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end shadow border-0">
                                <a class="dropdown-item small" href="#">Ayarlar</a>
                                <div class="dropdown-divider"></div>
                                <a class="dropdown-item small text-danger" href="/Account/Logout">Çıkış Yap</a>
                            </div>
                        </li>
                    </ul>
                </div>
            </nav>

            <div class="container-fluid p-4">
                @RenderBody()
            </div>

            <footer class="bg-white text-center py-3 border-top mt-auto">
                <small class="text-muted">© 2025 PowerGym Admin Paneli</small>
            </footer>

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Mobilde menüyü açıp kapatmak için
        $("#menu-toggle").click(function(e) {
            e.preventDefault();
            $("#wrapper").toggleClass("toggled");
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>