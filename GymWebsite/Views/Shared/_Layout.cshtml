@inject Microsoft.AspNetCore.Identity.SignInManager<UserIdentityAccount> signInManager
@inject Microsoft.AspNetCore.Identity.UserManager<UserIdentityAccount> userManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GymWebsite.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Gym Yönetim</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Trainer" asp-action="Index">Antrenörler</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="User" asp-action="Index">Üyeler</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Appointment" asp-action="Create">Randevu Al</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-primary fw-bold" asp-controller="AiManager" asp-action="Index">AI Asistanı ✨</a>
                        </li>

 
                        @if (signInManager.IsSignedIn(User))
                        {
                            <li class="nav-item ms-auto">
                                <a class="nav-link text-dark" asp-controller="User" asp-action="Index">Merhaba, @userManager.GetUserAsync(User).Result!.UserName</a>
                            </li>
                            <li class="nav-item ms-2">
                                <a class="btn btn-outline-dark fw-bold" asp-controller="User" asp-action="Logout">Çıkış Yap</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-auto">
                                <a class="btn btn-outline-primary fw-bold" asp-controller="User" asp-action="Register">Kayıt Ol</a>
                            </li>

                            <li class="nav-item me-2">
                                <a class="btn btn-outline-dark fw-bold" asp-controller="User" asp-action="Login">Giriş Yap</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - A. Dalkıran & H. E. Taşel - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
